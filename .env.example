# Hugging Face Inference API (replaces the previous OpenAI API key)
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx

# Any instruction-tuned model hosted on the Inference API works
HF_MODEL=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# App under test
BASE_URL=https:xxxxxxxxxxxxxxxxxxxxxxx
API_BASE_URL=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional test credentials
TEST_USERNAME=demo-user
TEST_PASSWORD=demo-pass
