{
  "info": {
    "name": "Users API Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /users - 200 and schema valid",
      "request": {
        "method": "GET",
        "url": "{{API_BASE_URL}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => Array.isArray(pm.response.json()));",
              "pm.test('Each user has required fields', () => {",
              "  const users = pm.response.json();",
              "  users.forEach(u => {",
              "    pm.expect(u).to.have.property('id');",
              "    pm.expect(u).to.have.property('name');",
              "    pm.expect(u).to.have.property('email');",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /users/:id - 404 for missing user",
      "request": {
        "method": "GET",
        "url": "{{API_BASE_URL}}/users/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404', () => pm.response.to.have.status(404));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST /users - create user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Amritanshu Anand\", \"email\": \"amritanshu@example.com\"}"
        },
        "url": "{{API_BASE_URL}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Returned user has id', () => pm.expect(pm.response.json()).to.have.property('id'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "API_BASE_URL", "value": "https://jsonplaceholder.typicode.com" }
  ]
}
